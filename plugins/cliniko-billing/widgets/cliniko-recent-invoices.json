{
  "id": "cliniko-recent-invoices",
  "title": "Cliniko — Recent invoices",
  "description": "Most recent invoices with status and amount.",
  "category": "health",
  "tags": [
    "cliniko",
    "billing",
    "invoices",
    "finance"
  ],
  "keywords": [
    "invoice",
    "invoices",
    "billing",
    "revenue",
    "payment"
  ],
  "connectorsUsed": [
    "cliniko-billing"
  ],
  "popularity": 85,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "cliniko-billing",
    "tool": "list_invoices",
    "params": {
      "per_page": 25,
      "sort": "issue_date:desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "table"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Invoices",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-billing/list_invoices/total_entries"
              }
            }
          }
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/cliniko-billing.list_invoices"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/cliniko-billing/list_invoices/invoices"
          },
          "columns": [
            {
              "id": "num",
              "header": "Invoice",
              "field": "number",
              "priority": 1,
              "width": 110
            },
            {
              "id": "issued",
              "header": "Issued",
              "field": "issue_date",
              "priority": 2,
              "width": 120
            },
            {
              "id": "status",
              "header": "Status",
              "field": "status",
              "priority": 2,
              "width": 110
            },
            {
              "id": "total",
              "header": "Total",
              "field": "total_amount",
              "priority": 1,
              "format": "currency",
              "width": 110,
              "align": "right"
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
