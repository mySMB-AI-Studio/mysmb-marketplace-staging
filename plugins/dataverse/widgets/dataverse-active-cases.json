{
  "id": "dataverse-active-cases",
  "title": "Active Cases",
  "description": "Open Dynamics 365 Customer Service cases — title, priority, status, and time created.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "cases", "incidents", "customer-service", "support"],
  "keywords": ["cases", "incidents", "open cases", "support queue", "customer service", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_cases",
    "params": {
      "org_url": "https://mysmb-dev.crm6.dynamics.com",
      "filter": "statecode eq 0",
      "select": "incidentid,title,ticketnumber,prioritycode,statecode,statuscode,createdon",
      "orderby": "createdon desc",
      "top": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": { "title": "Active Cases", "subtitle": "Open D365 Customer Service cases" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["statCount", "divider", "table"]
      },
      "statCount": {
        "type": "Stat",
        "props": {
          "label": "Open Cases",
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/dataverse/list_cases/items" } }
          }
        }
      },
      "divider": { "type": "Divider", "props": {} },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_cases" },
          "skeletonRows": 6,
          "rows": { "$state": "/dataverse/list_cases/items" },
          "columns": [
            { "id": "title",    "header": "Case",      "field": "title",        "priority": 1 },
            { "id": "ticket",   "header": "Ticket #",  "field": "ticketnumber", "width": 120, "priority": 1 },
            { "id": "priority", "header": "Priority",  "field": "prioritycode", "width": 90,  "priority": 2 },
            { "id": "status",   "header": "Status",    "field": "statuscode",   "width": 90,  "priority": 2 },
            { "id": "created",  "header": "Created",   "field": "createdon",    "width": 120, "priority": 2, "format": "relative" }
          ]
        }
      }
    }
  }
}
