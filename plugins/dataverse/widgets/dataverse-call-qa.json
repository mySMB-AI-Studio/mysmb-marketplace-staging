{
  "id": "dataverse-call-qa",
  "title": "Call QA Scorecard",
  "description": "Recent call QA scores from Dynamics 365 — agent, customer, call summary, score out of 100, and pass/fail grade.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "call-qa", "scoring", "agent-performance", "customer-service", "support"],
  "keywords": ["call qa", "quality assurance", "agent score", "call scoring", "transcript", "pass fail", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_call_qa_scores",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "top": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": { "title": "Call QA Scorecard", "subtitle": "Recent scored calls from D365" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["stats", "divider", "table"]
      },
      "stats": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statCount", "statPass"]
      },
      "statCount": {
        "type": "Stat",
        "props": {
          "label": "Calls Scored",
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/dataverse/list_call_qa_scores/qa_scores" } }
          }
        }
      },
      "statPass": {
        "type": "Stat",
        "props": {
          "label": "Passed",
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_call_qa_scores/qa_scores" },
              "field": "mysmbai_passed",
              "eq": true
            }
          }
        }
      },
      "divider": { "type": "Divider", "props": {} },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_call_qa_scores" },
          "skeletonRows": 5,
          "rows": { "$state": "/dataverse/list_call_qa_scores/qa_scores" },
          "columns": [
            { "id": "summary", "header": "Call Summary",  "field": "mysmbai_callsummary", "priority": 1 },
            { "id": "score",   "header": "Score /100",    "field": "mysmbai_totalscore",  "width": 100, "priority": 1, "align": "right" },
            { "id": "grade",   "header": "Grade",         "field": "mysmbai_grade",       "width": 140, "priority": 1, "variant": "badge" },
            { "id": "comment", "header": "Comment",       "field": "mysmbai_comments",    "priority": 2 },
            { "id": "created", "header": "Scored",        "field": "createdon",           "width": 120, "priority": 2, "format": "relative" }
          ]
        }
      }
    }
  }
}
