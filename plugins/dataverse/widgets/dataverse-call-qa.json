{
  "id": "dataverse-call-qa-v2",
  "title": "Call QA Scorecard",
  "description": "Recent call QA scores from Dynamics 365 — call summary, score out of 100, and pass/fail grade.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "call-qa", "scoring", "agent-performance", "customer-service", "support"],
  "keywords": ["call qa", "quality assurance", "agent score", "call scoring", "transcript", "pass fail", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 7 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_call_qa_scores",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "top": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "statsGrid", "div1", "callList", "div2", "footer"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Call QA Scorecard", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Customer Service" } },
      "brandBadge": { "type": "Badge", "props": { "label": "Dynamics 365", "tone": "info" } },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["tileScored", "tilePassed"]
      },
      "tileScored": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackScored"] },
      "stackScored": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconScored", "valScored", "lblScored"]
      },
      "iconScored": { "type": "Icon", "props": { "name": "ClipboardList", "size": "sm", "tone": "accent" } },
      "valScored": {
        "type": "Heading",
        "props": {
          "text": { "$computed": "count", "args": { "value": { "$state": "/dataverse/list_call_qa_scores/qa_scores" } } },
          "level": "h2"
        }
      },
      "lblScored": { "type": "Caption", "props": { "text": "Scored" } },

      "tilePassed": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackPassed"] },
      "stackPassed": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconPassed", "valPassed", "lblPassed"]
      },
      "iconPassed": { "type": "Icon", "props": { "name": "CheckCircle", "size": "sm", "tone": "positive" } },
      "valPassed": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_call_qa_scores/qa_scores" },
              "field": "mysmbai_passed",
              "eq": true
            }
          },
          "level": "h2"
        }
      },
      "lblPassed": { "type": "Caption", "props": { "text": "Passed" } },

      "div1": { "type": "Divider" },

      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "repeat": {
          "statePath": "/dataverse/list_call_qa_scores/qa_scores",
          "key": "mysmbai_qascoreid"
        },
        "children": ["callRow"]
      },
      "callRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["callLeft", "callScore", "callGrade"]
      },
      "callLeft": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["callSummary", "callDate"]
      },
      "callSummary": {
        "type": "Text",
        "props": { "text": { "$item": "mysmbai_callsummary" }, "size": "sm", "weight": "medium" }
      },
      "callDate": {
        "type": "Caption",
        "props": { "text": { "$item": "createdon" } }
      },
      "callScore": {
        "type": "Badge",
        "props": { "text": { "$item": "mysmbai_totalscore" }, "tone": "accent", "variant": "soft" }
      },
      "callGrade": {
        "type": "Badge",
        "props": { "text": { "$item": "mysmbai_grade" }, "tone": "info", "variant": "soft" }
      },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": { "label": "Open in D365", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
