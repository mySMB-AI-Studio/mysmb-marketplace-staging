{
  "id": "dataverse-sla-performance-demo",
  "title": "SLA Performance (Demo)",
  "description": "Demo — live SLA KPI status across active Dynamics 365 cases with static sample data.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "sla", "performance", "customer-service", "support", "demo"],
  "keywords": ["sla", "service level", "breach", "at risk", "kpi", "performance", "d365", "demo"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min":       { "colSpan": 5, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": { "title": "SLA Performance", "subtitle": "Active SLA KPIs — ordered by failure time" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["stats", "divider", "slaList"]
      },
      "stats": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statActive", "statBreached"]
      },
      "statActive": {
        "type": "Stat",
        "props": { "label": "Active SLAs", "value": 5 }
      },
      "statBreached": {
        "type": "Stat",
        "props": { "label": "Breached", "value": 1, "tone": "destructive" }
      },
      "divider": { "type": "Divider", "props": {} },
      "slaList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3", "s4", "s5"]
      },

      "s1": { "type": "Row", "props": { "gap": "sm" }, "children": ["s1left", "s1badge"] },
      "s1left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["s1name", "s1time"] },
      "s1name": { "type": "Text", "props": { "text": "Resolution SLA — CAS-00835", "weight": "bold" } },
      "s1time": { "type": "Caption", "props": { "text": "Breach in 1 hour" } },
      "s1badge": { "type": "Badge", "props": { "label": "At Risk" } },

      "s2": { "type": "Row", "props": { "gap": "sm" }, "children": ["s2left", "s2badge"] },
      "s2left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["s2name", "s2time"] },
      "s2name": { "type": "Text", "props": { "text": "First Response — CAS-00814", "weight": "bold" } },
      "s2time": { "type": "Caption", "props": { "text": "Breach in 2 hours" } },
      "s2badge": { "type": "Badge", "props": { "label": "In Progress" } },

      "s3": { "type": "Row", "props": { "gap": "sm" }, "children": ["s3left", "s3badge"] },
      "s3left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["s3name", "s3time"] },
      "s3name": { "type": "Text", "props": { "text": "Resolution SLA — CAS-00821", "weight": "bold" } },
      "s3time": { "type": "Caption", "props": { "text": "Breach in 4 hours" } },
      "s3badge": { "type": "Badge", "props": { "label": "In Progress" } },

      "s4": { "type": "Row", "props": { "gap": "sm" }, "children": ["s4left", "s4badge"] },
      "s4left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["s4name", "s4time"] },
      "s4name": { "type": "Text", "props": { "text": "First Response — CAS-00829", "weight": "bold" } },
      "s4time": { "type": "Caption", "props": { "text": "Breach in 6 hours" } },
      "s4badge": { "type": "Badge", "props": { "label": "In Progress" } },

      "s5": { "type": "Row", "props": { "gap": "sm" }, "children": ["s5left", "s5badge"] },
      "s5left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["s5name", "s5time"] },
      "s5name": { "type": "Text", "props": { "text": "Resolution SLA — CAS-00814", "weight": "bold" } },
      "s5time": { "type": "Caption", "props": { "text": "Breached 30 minutes ago" } },
      "s5badge": { "type": "Badge", "props": { "label": "Breached" } }
    }
  }
}
