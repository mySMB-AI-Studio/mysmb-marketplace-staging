{
  "id": "dataverse-leads-overview-v1",
  "status": "published",
  "title": "Leads Overview",
  "description": "Active Dynamics 365 leads with qualification stats — active count, qualified this month, and conversion rate.",
  "category": "sales",
  "tags": ["dataverse", "dynamics-365", "sales", "leads", "crm", "pipeline", "conversion"],
  "keywords": ["leads", "lead pipeline", "qualified", "conversion rate", "top of funnel", "crm", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_leads_overview",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "top": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody", "footerDivider", "footer"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Leads Overview", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Sales" } },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 3 },
        "children": ["tileActive", "tileQualified", "tileRate"]
      },

      "tileActive": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackActive"] },
      "stackActive": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconActive", "valActive", "lblActive"]
      },
      "iconActive": { "type": "Icon", "props": { "name": "Users", "size": "sm", "tone": "accent" } },
      "valActive": {
        "type": "Stat",
        "props": { "value": { "$state": "/dataverse/list_leads_overview/total_active" } }
      },
      "lblActive": { "type": "Caption", "props": { "text": "Active Leads" } },

      "tileQualified": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackQualified"] },
      "stackQualified": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconQualified", "valQualified", "lblQualified"]
      },
      "iconQualified": { "type": "Icon", "props": { "name": "UserCheck", "size": "sm", "tone": "positive" } },
      "valQualified": {
        "type": "Stat",
        "props": { "value": { "$state": "/dataverse/list_leads_overview/qualified_this_month" } }
      },
      "lblQualified": { "type": "Caption", "props": { "text": "Qualified This Month" } },

      "tileRate": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackRate"] },
      "stackRate": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconRate", "valRate", "lblRate"]
      },
      "iconRate": { "type": "Icon", "props": { "name": "TrendingUp", "size": "sm", "tone": "accent" } },
      "valRate": {
        "type": "Stat",
        "props": { "value": { "$state": "/dataverse/list_leads_overview/conversion_rate" } }
      },
      "lblRate": { "type": "Caption", "props": { "text": "Conversion Rate" } },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": { "type": "Body", "props": {}, "children": ["table"] },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_leads_overview" },
          "skeletonRows": 5,
          "rows": { "$state": "/dataverse/list_leads_overview/leads" },
          "columns": [
            { "id": "name",    "header": "Name",      "field": "fullname",    "priority": 1 },
            { "id": "company", "header": "Company",   "field": "companyname", "width": 140, "priority": 1 },
            { "id": "source",  "header": "Source",    "field": "source_label","width": 130, "priority": 2 },
            { "id": "created", "header": "Created",   "field": "createdon",  "width": 110, "priority": 2, "format": "relative" }
          ]
        }
      },

      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": { "label": "Open in D365", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
