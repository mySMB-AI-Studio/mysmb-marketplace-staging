{
  "id": "myob-aged-receivables",
  "title": "MYOB — Aged Receivables",
  "description": "Open invoices aggregated per customer — total balance owed with overdue indicator, sorted worst-first.",
  "category": "finance",
  "tags": ["myob", "receivables", "aging", "ar", "finance", "overdue"],
  "keywords": ["aged", "aging", "receivables", "ar", "outstanding", "overdue", "myob", "customers"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 500 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/myob-accounting/list_invoices/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/arData",
              "value": {
                "$computed": "myob-accounting_ar_by_customer",
                "args": {
                  "value": { "$state": "/myob-accounting/list_invoices/Items" }
                }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Aged Receivables", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "contentArea"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skel1", "skel2", "skel3", "skel4"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "skel1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel4": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No outstanding receivables.", "icon": "Trophy" },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/arData/customerCount", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack",
        "props": { "gap": "lg" },
        "children": ["statGrid", "tableArea"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/arData/customerCount" }
          ]
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statCountSection", "statTotalSection"]
      },
      "statCountSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statCount"]
      },
      "statTotalSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statTotal"]
      },
      "statCount": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statCountLabel", "statCountValue"]
      },
      "statCountLabel": {
        "type": "Eyebrow",
        "props": { "text": "Customers Owing" }
      },
      "statCountValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/arData/customerCount" },
          "tone": "warning"
        }
      },
      "statTotal": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statTotalLabel", "statTotalValue"]
      },
      "statTotalLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total Outstanding" }
      },
      "statTotalValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$state": "/ui/arData/grandTotal" } }
          },
          "tone": "warning"
        }
      },

      "tableArea": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["colHeaders", "colHeaderDivider", "dataRow"]
      },
      "colHeaders": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "minmax(0, 1fr) 6rem 8rem" },
        "children": ["hdrNameCol", "hdrInvWrap", "hdrAmtWrap"]
      },
      "hdrNameCol": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["hdrName"]
      },
      "hdrName": {
        "type": "Eyebrow",
        "props": { "text": "Customer" }
      },
      "hdrInvWrap": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["hdrInv"]
      },
      "hdrInv": {
        "type": "Eyebrow",
        "props": { "text": "Invoices" }
      },
      "hdrAmtWrap": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["hdrAmt"]
      },
      "hdrAmt": {
        "type": "Eyebrow",
        "props": { "text": "Amount" }
      },
      "colHeaderDivider": {
        "type": "Divider"
      },

      "dataRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "template": "minmax(0, 1fr) 6rem 8rem" },
        "children": ["nameCol", "invCol", "amtCol"],
        "repeat": {
          "statePath": "/ui/arData/entries",
          "key": "uid"
        }
      },
      "nameCol": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["nameText"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "invCol": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["invText"]
      },
      "invText": {
        "type": "Text",
        "props": {
          "text": { "$item": "invoiceCount" },
          "size": "sm"
        }
      },
      "amtCol": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["amtText"]
      },
      "amtText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "total" } }
          },
          "size": "sm",
          "weight": "semibold",
          "tone": { "$item": "badgeTone" }
        }
      },

    }
  },
  "status": "published"
}
