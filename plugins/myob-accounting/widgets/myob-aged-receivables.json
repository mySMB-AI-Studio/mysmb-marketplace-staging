{
  "id": "myob-aged-receivables",
  "title": "MYOB — Aged Receivables",
  "description": "Open sales invoices ordered by due date — oldest overdue at the top.",
  "category": "finance",
  "tags": ["myob", "receivables", "aging", "ar", "finance", "overdue"],
  "keywords": ["aged", "aging", "receivables", "ar", "outstanding", "overdue", "myob"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Aged Receivables", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open invoices",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
              }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "children": ["loading", "empty", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No outstanding receivables — rare and glorious." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/myob-accounting/list_invoices/Items/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row"],
        "repeat": {
          "statePath": "/myob-accounting/list_invoices/Items",
          "key": "UID"
        },
        "visible": { "$state": "/_loading/myob-accounting.list_invoices", "not": true }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "auto minmax(0, 1fr) 6rem 7rem"
        },
        "children": ["avatar", "identity", "amount", "due"]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": { "value": { "$item": "Customer/Name" } }
          },
          "size": "sm"
        }
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["idTop", "idBottom"]
      },
      "idTop": {
        "type": "Text",
        "props": {
          "text": { "$item": "Customer/Name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "idBottom": {
        "type": "Caption",
        "props": { "text": { "$item": "Number" } }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "BalanceDueAmount" } }
          },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "due": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": { "value": { "$item": "DueDate" } }
          },
          "tone": "warning",
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
