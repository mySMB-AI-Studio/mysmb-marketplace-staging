{
  "id": "myob-aged-receivables",
  "title": "MYOB — Aged Receivables",
  "description": "Open sales invoices ordered by due date — oldest overdue at the top.",
  "category": "finance",
  "tags": ["myob", "receivables", "aging", "ar", "finance", "overdue"],
  "keywords": ["aged", "aging", "receivables", "ar", "outstanding", "overdue", "myob"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "order_by": "DueDate", "order_desc": false, "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Aged Receivables", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open invoices",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["empty", "list"]
      },
      "empty": {
        "type": "Empty",
        "props": { "message": "No outstanding receivables." },
        "visible": { "$state": "/myob-accounting/list_invoices/Items/0", "not": true }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/myob-accounting/list_invoices/Items",
          "key": "UID"
        },
        "visible": { "$state": "/myob-accounting/list_invoices/Items/0" }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true },
        "children": ["avatar", "label", "dueBadge", "amount"]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": { "value": { "$item": "Customer/Name" } }
          },
          "size": "sm"
        }
      },
      "label": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["labelTop", "labelBottom"]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": { "$item": "Customer/Name" },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Inv {num}",
              "num": { "$item": "Number" }
            }
          },
          "size": "sm",
          "tone": "muted"
        }
      },
      "dueBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Due {d}",
              "d": {
                "$computed": "format_date_au",
                "args": { "value": { "$item": "DueDate" } }
              }
            }
          },
          "tone": "destructive",
          "variant": "soft"
        }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": { "value": { "$item": "BalanceDueAmount" } }
          },
          "weight": "semibold",
          "size": "sm"
        }
      }
    }
  },
  "status": "published"
}
