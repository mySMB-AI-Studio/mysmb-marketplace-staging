{
  "id": "myob-open-bills",
  "title": "MYOB — Open Bills",
  "description": "Outstanding purchase bills from MYOB AccountRight — supplier, amount due, and due date.",
  "category": "finance",
  "tags": ["myob", "bills", "payables", "finance", "accounting", "ap"],
  "keywords": ["bills", "purchase", "payables", "ap", "outstanding", "myob", "supplier"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_bills",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/myob-accounting/list_bills/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortedItems",
              "value": {
                "$computed": "myob-accounting_sort_items",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": { "$state": "/ui/sort/col" },
                  "dir": { "$state": "/ui/sort/dir" }
                }
              }
            }
          },
          "/ui/sort/col": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortedItems",
              "value": {
                "$computed": "myob-accounting_sort_items",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": { "$state": "/ui/sort/col" },
                  "dir": { "$state": "/ui/sort/dir" }
                }
              }
            }
          },
          "/ui/sort/dir": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortedItems",
              "value": {
                "$computed": "myob-accounting_sort_items",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": { "$state": "/ui/sort/col" },
                  "dir": { "$state": "/ui/sort/dir" }
                }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Bills", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "contentArea"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skel1", "skel2", "skel3", "skel4"],
        "visible": { "$state": "/_loading/myob-accounting.list_bills" }
      },
      "skel1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel4": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open bills — nothing to pay right now.", "icon": "CheckCircle" },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_bills", "not": true },
            { "$state": "/myob-accounting/list_bills/Items/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack",
        "props": { "gap": "lg" },
        "children": ["statGrid", "tableArea"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_bills", "not": true },
            { "$state": "/myob-accounting/list_bills/Items/0" }
          ]
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statCountSection", "statTotalSection"]
      },
      "statCountSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statCount"]
      },
      "statTotalSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statTotal"]
      },
      "statCount": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statCountLabel", "statCountValue"]
      },
      "statCountLabel": {
        "type": "Eyebrow",
        "props": { "text": "Bills to Pay" }
      },
      "statCountValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/myob-accounting/list_bills/Items" } }
          },
          "tone": "destructive"
        }
      },
      "statTotal": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statTotalLabel", "statTotalValue"]
      },
      "statTotalLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total Due" }
      },
      "statTotalValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": "BalanceDueAmount"
                }
              }
            }
          },
          "tone": "destructive"
        }
      },

      "tableArea": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["staticHeader", "list"]
      },
      "staticHeader": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["staticRow", "staticDivider"]
      },
      "staticRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "minmax(0, 1fr) 7rem 8rem" },
        "children": ["hdrCol1", "hdrCol2", "hdrCol3"]
      },
      "hdrCol1": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["hdrLabel1"]
      },
      "hdrLabel1": {
        "type": "Button",
        "props": {
          "label": {
            "$computed": "myob-accounting_sort_label",
            "args": {
              "label": "Supplier",
              "col": "Supplier/Name",
              "currentCol": { "$state": "/ui/sort/col" },
              "currentDir": { "$state": "/ui/sort/dir" }
            }
          },
          "variant": "ghost",
          "size": "xs",
          "align": "start"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/dir",
                "value": {
                  "$computed": "myob-accounting_sort_toggle_dir",
                  "args": {
                    "col": "Supplier/Name",
                    "currentCol": { "$state": "/ui/sort/col" },
                    "currentDir": { "$state": "/ui/sort/dir" }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/col",
                "value": "Supplier/Name"
              }
            }
          ]
        }
      },
      "hdrCol2": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["hdrLabel2"]
      },
      "hdrLabel2": {
        "type": "Button",
        "props": {
          "label": {
            "$computed": "myob-accounting_sort_label",
            "args": {
              "label": "Due Date",
              "col": "Terms/DueDate",
              "currentCol": { "$state": "/ui/sort/col" },
              "currentDir": { "$state": "/ui/sort/dir" }
            }
          },
          "variant": "ghost",
          "size": "xs"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/dir",
                "value": {
                  "$computed": "myob-accounting_sort_toggle_dir",
                  "args": {
                    "col": "Terms/DueDate",
                    "currentCol": { "$state": "/ui/sort/col" },
                    "currentDir": { "$state": "/ui/sort/dir" }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/col",
                "value": "Terms/DueDate"
              }
            }
          ]
        }
      },
      "hdrCol3": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["hdrLabel3"]
      },
      "hdrLabel3": {
        "type": "Button",
        "props": {
          "label": {
            "$computed": "myob-accounting_sort_label",
            "args": {
              "label": "Amount",
              "col": "BalanceDueAmount",
              "currentCol": { "$state": "/ui/sort/col" },
              "currentDir": { "$state": "/ui/sort/dir" }
            }
          },
          "variant": "ghost",
          "size": "xs",
          "align": "end"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/dir",
                "value": {
                  "$computed": "myob-accounting_sort_toggle_dir",
                  "args": {
                    "col": "BalanceDueAmount",
                    "currentCol": { "$state": "/ui/sort/col" },
                    "currentDir": { "$state": "/ui/sort/dir" }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort/col",
                "value": "BalanceDueAmount"
              }
            }
          ]
        }
      },
      "staticDivider": {
        "type": "Divider"
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowWrapper"],
        "repeat": {
          "statePath": "/ui/sortedItems",
          "key": "UID"
        }
      },
      "rowWrapper": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["row", "rowDivider"]
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "template": "minmax(0, 1fr) 7rem 8rem" },
        "children": ["nameCol", "dateCol", "amtCol"]
      },
      "nameCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["nameText", "numText"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "Supplier/Name" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "numText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "#{num}", "num": { "$item": "Number" } }
          }
        }
      },
      "dateCol": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["dateText"]
      },
      "dateText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_date",
            "args": { "value": { "$item": "Terms/DueDate" } }
          },
          "size": "sm",
          "tone": {
            "$computed": "myob-accounting_due_tone",
            "args": { "value": { "$item": "Terms/DueDate" } }
          }
        }
      },
      "amtCol": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["amtText"]
      },
      "amtText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "BalanceDueAmount" } }
          },
          "size": "sm",
          "weight": "semibold",
          "tone": {
            "$computed": "myob-accounting_due_tone",
            "args": { "value": { "$item": "Terms/DueDate" } }
          }
        }
      },
      "rowDivider": {
        "type": "Divider"
      }

    }
  },
  "status": "published"
}
