{
  "id": "myob-open-bills",
  "title": "MYOB — Open Bills",
  "description": "Outstanding purchase bills from MYOB AccountRight — supplier, amount due, and due date.",
  "category": "finance",
  "tags": ["myob", "bills", "payables", "finance", "accounting", "ap"],
  "keywords": ["bills", "purchase", "payables", "ap", "outstanding", "myob", "supplier"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_bills",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody"],
        "watch": {
          "/myob-accounting/list_bills/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tableRows",
              "value": {
                "$computed": "myob-accounting_flatten_bills",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" }
                }
              }
            }
          }
        }
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Bills", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileTotal"]
      },
      "tileCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackCount"]
      },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": {
        "type": "Icon",
        "props": { "name": "Receipt", "size": "sm", "tone": "destructive" }
      },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/myob-accounting/list_bills/Items" } }
          },
          "tone": "destructive"
        }
      },
      "lblCount": {
        "type": "Caption",
        "props": { "text": "Bills to Pay" }
      },
      "tileTotal": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackTotal"]
      },
      "stackTotal": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconTotal", "valTotal", "lblTotal"]
      },
      "iconTotal": {
        "type": "Icon",
        "props": { "name": "DollarSign", "size": "sm", "tone": "destructive" }
      },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": "BalanceDueAmount"
                }
              }
            }
          },
          "tone": "destructive"
        }
      },
      "lblTotal": {
        "type": "Caption",
        "props": { "text": "Total Due" }
      },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["headerRow", "list"]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr) 96px 130px 120px",
          "gap": "sm"
        },
        "children": ["hdrSupplier", "hdrNumber", "hdrDue", "hdrAmount"]
      },
      "hdrSupplier": { "type": "Caption", "props": { "text": "SUPPLIER" } },
      "hdrNumber":   { "type": "Caption", "props": { "text": "BILL #" } },
      "hdrDue":      { "type": "Caption", "props": { "text": "DUE DATE" } },
      "hdrAmount":   { "type": "Caption", "props": { "text": "AMOUNT" } },

      "list": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "repeat": { "over": { "$state": "/ui/tableRows" } }
        },
        "children": ["dataRow"]
      },
      "dataRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr) 96px 130px 120px",
          "gap": "sm",
          "align": "center"
        },
        "children": ["cellSupplier", "cellNumber", "cellDue", "cellAmount"]
      },
      "cellSupplier": {
        "type": "Text",
        "props": { "text": { "$item": "supplierName" } }
      },
      "cellNumber": {
        "type": "Text",
        "props": { "text": { "$item": "number" } }
      },
      "cellDue": {
        "type": "Text",
        "props": {
          "text": { "$item": "dueDate" },
          "tone": {
            "$computed": "myob-accounting_is_overdue",
            "args": { "value": { "$item": "rawDue" } }
          }
        }
      },
      "cellAmount": {
        "type": "Text",
        "props": { "text": { "$item": "amount" } }
      }

    }
  },
  "status": "published"
}
