{
  "id": "myob-open-bills",
  "title": "MYOB — Open Bills",
  "description": "Outstanding purchase bills from MYOB AccountRight — supplier, amount due, and due date.",
  "category": "finance",
  "tags": ["myob", "bills", "payables", "finance", "accounting", "ap"],
  "keywords": ["bills", "purchase", "payables", "ap", "outstanding", "myob", "supplier"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_bills",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Bills", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} to pay",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/myob-accounting/list_bills/Items" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skel1", "skel2", "skel3", "skel4"],
        "visible": { "$state": "/_loading/myob-accounting.list_bills" }
      },
      "skel1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel4": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No open bills — nothing to pay right now." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_bills", "not": true },
            { "$state": "/myob-accounting/list_bills/Items/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/myob-accounting/list_bills/Items",
          "key": "UID"
        },
        "visible": { "$state": "/_loading/myob-accounting.list_bills", "not": true }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true },
        "children": ["label", "due", "amount"]
      },
      "label": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["labelTop", "labelBottom"]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{num} — {name}",
              "num": { "$item": "Number" },
              "name": { "$item": "Supplier/Name" }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{status}",
              "status": { "$item": "Status" }
            }
          },
          "size": "sm",
          "tone": "muted"
        }
      },
      "due": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Due {d}",
              "d": { "$item": "DueDate" }
            }
          },
          "tone": "warning",
          "variant": "soft"
        }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": { "value": { "$item": "AmountDue" } }
          },
          "weight": "semibold",
          "size": "sm"
        }
      }
    }
  },
  "status": "published"
}
