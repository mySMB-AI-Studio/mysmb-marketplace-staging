{
  "id": "myob-open-invoices",
  "title": "MYOB — Open Invoices",
  "description": "Outstanding sales invoices from MYOB AccountRight — customer, amount due, and due date at a glance.",
  "category": "finance",
  "tags": ["myob", "invoices", "finance", "accounting", "receivables"],
  "keywords": ["invoice", "invoices", "outstanding", "myob", "sales", "receivables", "open"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Invoices", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "contentArea"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skel1", "skel2", "skel3", "skel4"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "skel1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel4": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open invoices — you're all caught up.", "icon": "Trophy" },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/myob-accounting/list_invoices/Items/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack",
        "props": { "gap": "lg" },
        "children": ["statGrid", "tableArea"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/myob-accounting/list_invoices/Items/0" }
          ]
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statOpenSection", "statValueSection"]
      },
      "statOpenSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statOpen"]
      },
      "statValueSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statValue"]
      },
      "statOpen": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statOpenLabel", "statOpenValue"]
      },
      "statOpenLabel": {
        "type": "Eyebrow",
        "props": { "text": "Open Invoices" }
      },
      "statOpenValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
          },
          "tone": "accent"
        }
      },
      "statValue": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statValueLabel", "statValueStat"]
      },
      "statValueLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total Due" }
      },
      "statValueStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/myob-accounting/list_invoices/Items" },
                  "field": "BalanceDueAmount"
                }
              }
            }
          },
          "tone": "accent"
        }
      },

      "tableArea": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["headerWrapper", "colHeaderDivider", "list"]
      },
      "headerWrapper": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["headerRowWrapper"]
      },
      "headerRowWrapper": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["colHeaders"]
      },
      "colHeaders": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "minmax(0, 1fr) 7rem 8rem" },
        "children": ["hdrNameCol", "hdrDateWrap", "hdrAmtWrap"]
      },
      "hdrNameCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["hdrName"]
      },
      "hdrName": {
        "type": "Eyebrow",
        "props": { "text": "Customer" }
      },
      "hdrDateWrap": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["hdrDate"]
      },
      "hdrDate": {
        "type": "Eyebrow",
        "props": { "text": "Due Date" }
      },
      "hdrAmtWrap": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["hdrAmt"]
      },
      "hdrAmt": {
        "type": "Eyebrow",
        "props": { "text": "Amount" }
      },
      "colHeaderDivider": {
        "type": "Divider"
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowWrapper"],
        "repeat": {
          "statePath": "/myob-accounting/list_invoices/Items",
          "key": "UID"
        }
      },
      "rowWrapper": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["row", "rowDivider"]
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "template": "minmax(0, 1fr) 7rem 8rem" },
        "children": ["nameCol", "dateCol", "amtCol"]
      },
      "nameCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["nameText", "numText"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "Customer/Name" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "numText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "#{num}", "num": { "$item": "Number" } }
          }
        }
      },
      "dateCol": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["dateText"]
      },
      "dateText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_date",
            "args": { "value": { "$item": "Terms/DueDate" } }
          },
          "size": "sm",
          "tone": {
            "$computed": "myob-accounting_due_tone",
            "args": { "value": { "$item": "Terms/DueDate" } }
          }
        }
      },
      "amtCol": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["amtText"]
      },
      "amtText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "BalanceDueAmount" } }
          },
          "size": "sm",
          "weight": "semibold",
          "tone": {
            "$computed": "myob-accounting_due_tone",
            "args": { "value": { "$item": "Terms/DueDate" } }
          }
        }
      },
      "rowDivider": {
        "type": "Divider"
      }

    }
  },
  "status": "published"
}
