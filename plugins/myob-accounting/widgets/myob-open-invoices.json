{
  "id": "myob-open-invoices",
  "title": "MYOB — Open Invoices",
  "description": "Outstanding sales invoices from MYOB AccountRight — customer, amount due, and due date at a glance.",
  "category": "finance",
  "tags": ["myob", "invoices", "finance", "accounting", "receivables"],
  "keywords": ["invoice", "invoices", "outstanding", "myob", "sales", "receivables", "open"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileTotal"]
      },
      "tileCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackCount"]
      },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": {
        "type": "Icon",
        "props": { "name": "FileText", "size": "sm", "tone": "accent" }
      },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
          },
          "tone": "accent"
        }
      },
      "lblCount": {
        "type": "Caption",
        "props": { "text": "Open Invoices" }
      },
      "tileTotal": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackTotal"]
      },
      "stackTotal": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconTotal", "valTotal", "lblTotal"]
      },
      "iconTotal": {
        "type": "Icon",
        "props": { "name": "DollarSign", "size": "sm", "tone": "accent" }
      },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/myob-accounting/list_invoices/Items" },
                  "field": "BalanceDueAmount"
                }
              }
            }
          },
          "tone": "accent"
        }
      },
      "lblTotal": {
        "type": "Caption",
        "props": { "text": "Total Due" }
      },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["tableArea"]
      },
      "tableArea": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["headerRow", "headerDivider", "list"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "minmax(0, 1fr) 100px 130px 120px" },
        "children": ["hdrCol1", "hdrCol2", "hdrCol3", "hdrCol4"]
      },
      "hdrCol1": { "type": "Stack", "props": { "gap": "none" }, "children": ["hdrLabel1"] },
      "hdrLabel1": { "type": "Eyebrow", "props": { "text": "Customer" } },
      "hdrCol2": { "type": "Stack", "props": { "gap": "none" }, "children": ["hdrLabel2"] },
      "hdrLabel2": { "type": "Eyebrow", "props": { "text": "Invoice #" } },
      "hdrCol3": { "type": "Stack", "props": { "gap": "none" }, "children": ["hdrLabel3"] },
      "hdrLabel3": { "type": "Eyebrow", "props": { "text": "Due Date" } },
      "hdrCol4": { "type": "Row", "props": { "justify": "end" }, "children": ["hdrLabel4"] },
      "hdrLabel4": { "type": "Eyebrow", "props": { "text": "Amount" } },
      "headerDivider": { "type": "Divider" },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["row", "rowDivider"],
        "repeat": {
          "statePath": "/myob-accounting/list_invoices/Items",
          "key": "UID"
        }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "template": "minmax(0, 1fr) 100px 130px 120px" },
        "children": ["nameCol", "numCol", "dateCol", "amtCol"]
      },
      "nameCol": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["nameText"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "Customer/Name" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "numCol": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["numText"]
      },
      "numText": {
        "type": "Text",
        "props": {
          "text": { "$item": "Number" },
          "size": "sm"
        }
      },
      "dateCol": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["dateText"]
      },
      "dateText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_date",
            "args": { "value": { "$item": "Terms/DueDate" } }
          },
          "size": "sm",
          "tone": {
            "$computed": "myob-accounting_due_tone",
            "args": { "value": { "$item": "Terms/DueDate" } }
          }
        }
      },
      "amtCol": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["amtText"]
      },
      "amtText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "BalanceDueAmount" } }
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "rowDivider": { "type": "Divider" }

    }
  },
  "status": "published"
}
