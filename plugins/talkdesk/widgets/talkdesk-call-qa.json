{
  "id": "talkdesk-call-qa",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores from the mySMB scoring service.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 4 },
    "min":       { "colSpan": 4, "rowSpan": 3 },
    "max":       { "colSpan": 10, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "talkdesk",
    "tool": "get_qa_scorecard",
    "params": { "limit": 5 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "avg", "table"]
      },
      "header": {
        "type": "Header",
        "props": { "title": "Call QA Scorecard", "subtitle": "Recent scored calls" }
      },
      "avg": {
        "type": "Stat",
        "props": {
          "label": "Avg Score",
          "value": { "$state": "/talkdesk/get_qa_scorecard/average_score" },
          "suffix": "/100"
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "rows": { "$state": "/talkdesk/get_qa_scorecard/calls" },
          "columns": [
            { "key": "agent",         "label": "Agent" },
            { "key": "overall_score", "label": "Score" },
            { "key": "grade",         "label": "Grade" },
            { "key": "summary",       "label": "Result" },
            { "key": "scored_at",     "label": "Time", "format": "datetime" }
          ]
        }
      }
    }
  }
}
