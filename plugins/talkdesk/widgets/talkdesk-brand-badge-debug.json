{
  "id": "talkdesk-brand-badge-debug",
  "title": "Brand Badge Debug",
  "description": "Temporary debug widget — tests badge placement in header area without the Header component.",
  "category": "support",
  "tags": ["talkdesk", "debug"],
  "keywords": ["debug"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min":       { "colSpan": 3, "rowSpan": 3 },
    "max":       { "colSpan": 8, "rowSpan": 6 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["hdr", "div1", "body"]
      },

      "hdr": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleStack", "brandBadge"]
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Badge Debug", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Debug" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "text": "talkdesk", "tone": "accent", "variant": "soft" }
      },

      "div1": { "type": "Divider" },

      "body": {
        "type": "Text",
        "props": { "text": "If the talkdesk badge is visible top-right, the plain-Row approach works and Header is the problem.", "size": "sm" }
      }
    }
  },
  "status": "published"
}
