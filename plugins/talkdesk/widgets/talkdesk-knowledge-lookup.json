{
  "id": "talkdesk-knowledge-lookup",
  "title": "Knowledge Lookup Activity",
  "description": "Today's AI Agent knowledge lookups — how many queries were resolved by the knowledge base versus escalated to a human agent.",
  "category": "support",
  "tags": ["talkdesk", "knowledge", "ai", "support", "workspace", "agent", "activity"],
  "keywords": ["talkdesk", "knowledge base", "ai agent", "lookup", "resolved", "escalated", "support", "workspace", "activity", "history"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "statsGrid", "div1", "lookupList", "div2", "footer"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BookOpen", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Knowledge Lookup Activity", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Today" }
      },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "md" },
        "children": ["statTotal", "statResolved", "statEscalated"]
      },
      "statTotal": {
        "type": "Stat",
        "props": { "label": "Lookups", "value": 18 }
      },
      "statResolved": {
        "type": "Stat",
        "props": { "label": "Resolved", "value": 14 }
      },
      "statEscalated": {
        "type": "Stat",
        "props": { "label": "Escalated", "value": 4 }
      },

      "div1": { "type": "Divider" },

      "lookupList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["r1", "r2", "r3", "r4", "r5"]
      },

      "r1": {
        "type": "Row",
        "props": { "align": "start", "gap": "md" },
        "children": ["r1left", "r1badge"]
      },
      "r1left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["r1text", "r1sub"]
      },
      "r1text": {
        "type": "Text",
        "props": { "text": "Password reset steps", "size": "sm", "weight": "medium" }
      },
      "r1sub": {
        "type": "Caption",
        "props": { "text": "Account & Security" }
      },
      "r1badge": {
        "type": "Badge",
        "props": { "text": "Resolved", "tone": "positive", "variant": "soft" }
      },

      "r2": {
        "type": "Row",
        "props": { "align": "start", "gap": "md" },
        "children": ["r2left", "r2badge"]
      },
      "r2left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["r2text", "r2sub"]
      },
      "r2text": {
        "type": "Text",
        "props": { "text": "Cancel subscription process", "size": "sm", "weight": "medium" }
      },
      "r2sub": {
        "type": "Caption",
        "props": { "text": "Billing & Subscriptions" }
      },
      "r2badge": {
        "type": "Badge",
        "props": { "text": "Escalated", "tone": "warning", "variant": "soft" }
      },

      "r3": {
        "type": "Row",
        "props": { "align": "start", "gap": "md" },
        "children": ["r3left", "r3badge"]
      },
      "r3left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["r3text", "r3sub"]
      },
      "r3text": {
        "type": "Text",
        "props": { "text": "Invoice download & PDF export", "size": "sm", "weight": "medium" }
      },
      "r3sub": {
        "type": "Caption",
        "props": { "text": "Billing & Payments" }
      },
      "r3badge": {
        "type": "Badge",
        "props": { "text": "Resolved", "tone": "positive", "variant": "soft" }
      },

      "r4": {
        "type": "Row",
        "props": { "align": "start", "gap": "md" },
        "children": ["r4left", "r4badge"]
      },
      "r4left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["r4text", "r4sub"]
      },
      "r4text": {
        "type": "Text",
        "props": { "text": "Two-factor authentication setup", "size": "sm", "weight": "medium" }
      },
      "r4sub": {
        "type": "Caption",
        "props": { "text": "Account & Security" }
      },
      "r4badge": {
        "type": "Badge",
        "props": { "text": "Resolved", "tone": "positive", "variant": "soft" }
      },

      "r5": {
        "type": "Row",
        "props": { "align": "start", "gap": "md" },
        "children": ["r5left", "r5badge"]
      },
      "r5left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["r5text", "r5sub"]
      },
      "r5text": {
        "type": "Text",
        "props": { "text": "Refund policy for annual plans", "size": "sm", "weight": "medium" }
      },
      "r5sub": {
        "type": "Caption",
        "props": { "text": "Billing & Subscriptions" }
      },
      "r5badge": {
        "type": "Badge",
        "props": { "text": "Escalated", "tone": "warning", "variant": "soft" }
      },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Talkdesk",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://my.talkdesk.com", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
