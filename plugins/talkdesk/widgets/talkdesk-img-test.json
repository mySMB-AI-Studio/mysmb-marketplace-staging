{
  "id": "talkdesk-img-test",
  "title": "Image Test",
  "description": "Test RichHtml with base64 PNG brand logo.",
  "category": "support",
  "tags": ["talkdesk", "demo"],
  "keywords": ["test"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min":       { "colSpan": 3, "rowSpan": 3 },
    "max":       { "colSpan": 8, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "div1", "body"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleStack", "brandLogo"]
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Image Test", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk · Logo Test" }
      },
      "brandLogo": {
        "type": "RichHtml",
        "props": {
          "html": "<img src=\"data:image/png;base64,\" style=\"height:24px;width:auto;display:block;\" />"
        }
      },
      "div1": { "type": "Divider" },
      "body": {
        "type": "Text",
        "props": { "text": "If the Talkdesk logo appears top-right, RichHtml supports inline images.", "size": "sm" }
      }
    }
  },
  "status": "published"
}
