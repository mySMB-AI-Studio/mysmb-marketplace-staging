{
  "id": "talkdesk-qa-scorecard",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores — pass/fail breakdown per agent.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance", "pass", "fail"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "avgTile", "div1", "callList", "div2", "footer"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Call QA Scorecard", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Recent calls" }
      },

      "avgTile": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["avgStack"]
      },
      "avgStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["avgIco", "avgVal", "avgLbl"]
      },
      "avgIco": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "accent", "size": "sm" }
      },
      "avgVal": {
        "type": "Heading",
        "props": { "text": "82", "level": "h2" }
      },
      "avgLbl": {
        "type": "Caption",
        "props": { "text": "Avg Score · 5 calls" }
      },

      "div1": { "type": "Divider" },

      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["c1", "c2", "c3", "c4", "c5"]
      },

      "c1": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["c1name", "c1barWrap", "c1right"]
      },
      "c1name": {
        "type": "Text",
        "props": { "text": "Alice M.", "size": "sm", "weight": "medium" }
      },
      "c1barWrap": {
        "type": "Stack",
        "props": { "grow": true },
        "children": ["c1bar"]
      },
      "c1bar": {
        "type": "ProgressBar",
        "props": { "value": 0.92, "tone": "success" }
      },
      "c1right": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c1score", "c1pass"]
      },
      "c1score": {
        "type": "Text",
        "props": { "text": "92", "size": "sm", "weight": "medium" }
      },
      "c1pass": {
        "type": "Badge",
        "props": { "label": "Pass", "tone": "success" }
      },

      "c2": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["c2name", "c2barWrap", "c2right"]
      },
      "c2name": {
        "type": "Text",
        "props": { "text": "Bob K.", "size": "sm", "weight": "medium" }
      },
      "c2barWrap": {
        "type": "Stack",
        "props": { "grow": true },
        "children": ["c2bar"]
      },
      "c2bar": {
        "type": "ProgressBar",
        "props": { "value": 0.74, "tone": "destructive" }
      },
      "c2right": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c2score", "c2pass"]
      },
      "c2score": {
        "type": "Text",
        "props": { "text": "74", "size": "sm", "weight": "medium" }
      },
      "c2pass": {
        "type": "Badge",
        "props": { "label": "Fail", "tone": "destructive" }
      },

      "c3": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["c3name", "c3barWrap", "c3right"]
      },
      "c3name": {
        "type": "Text",
        "props": { "text": "Alice M.", "size": "sm", "weight": "medium" }
      },
      "c3barWrap": {
        "type": "Stack",
        "props": { "grow": true },
        "children": ["c3bar"]
      },
      "c3bar": {
        "type": "ProgressBar",
        "props": { "value": 0.88, "tone": "success" }
      },
      "c3right": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c3score", "c3pass"]
      },
      "c3score": {
        "type": "Text",
        "props": { "text": "88", "size": "sm", "weight": "medium" }
      },
      "c3pass": {
        "type": "Badge",
        "props": { "label": "Pass", "tone": "success" }
      },

      "c4": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["c4name", "c4barWrap", "c4right"]
      },
      "c4name": {
        "type": "Text",
        "props": { "text": "Carol T.", "size": "sm", "weight": "medium" }
      },
      "c4barWrap": {
        "type": "Stack",
        "props": { "grow": true },
        "children": ["c4bar"]
      },
      "c4bar": {
        "type": "ProgressBar",
        "props": { "value": 0.95, "tone": "success" }
      },
      "c4right": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c4score", "c4pass"]
      },
      "c4score": {
        "type": "Text",
        "props": { "text": "95", "size": "sm", "weight": "medium" }
      },
      "c4pass": {
        "type": "Badge",
        "props": { "label": "Pass", "tone": "success" }
      },

      "c5": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["c5name", "c5barWrap", "c5right"]
      },
      "c5name": {
        "type": "Text",
        "props": { "text": "Bob K.", "size": "sm", "weight": "medium" }
      },
      "c5barWrap": {
        "type": "Stack",
        "props": { "grow": true },
        "children": ["c5bar"]
      },
      "c5bar": {
        "type": "ProgressBar",
        "props": { "value": 0.61, "tone": "destructive" }
      },
      "c5right": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c5score", "c5pass"]
      },
      "c5score": {
        "type": "Text",
        "props": { "text": "61", "size": "sm", "weight": "medium" }
      },
      "c5pass": {
        "type": "Badge",
        "props": { "label": "Fail", "tone": "destructive" }
      },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Talkdesk",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://my.talkdesk.com", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
