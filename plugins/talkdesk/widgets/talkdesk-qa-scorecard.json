{
  "id": "talkdesk-qa-scorecard",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores — pass/fail breakdown per agent.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance", "pass", "fail"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "avgTile", "div1", "callList", "div2", "footer"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["titleLeft", "brandBadge"]
      },
      "titleLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "text": "talkdesk", "tone": "accent", "variant": "soft" }
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Call QA Scorecard", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Recent calls" }
      },

      "avgTile": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["avgStack"]
      },
      "avgStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["avgIco", "avgVal", "avgLbl"]
      },
      "avgIco": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "accent", "size": "sm" }
      },
      "avgVal": {
        "type": "Heading",
        "props": { "text": "82", "level": "h2" }
      },
      "avgLbl": {
        "type": "Caption",
        "props": { "text": "Avg Score · 5 calls" }
      },

      "div1": { "type": "Divider" },

      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["c1", "c2", "c3", "c4", "c5"]
      },

      "c1": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["c1info", "c1badges"]
      },
      "c1info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c1name", "c1sub"]
      },
      "c1name": {
        "type": "Text",
        "props": { "text": "Alice M.", "size": "sm", "weight": "medium" }
      },
      "c1sub": {
        "type": "Caption",
        "props": { "text": "Support Agent" }
      },
      "c1badges": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c1score", "c1pass"]
      },
      "c1score": {
        "type": "Badge",
        "props": { "text": "92 / 100", "tone": "positive" }
      },
      "c1pass": {
        "type": "Badge",
        "props": { "text": "Pass", "tone": "positive" }
      },

      "c2": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["c2info", "c2badges"]
      },
      "c2info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c2name", "c2sub"]
      },
      "c2name": {
        "type": "Text",
        "props": { "text": "Bob K.", "size": "sm", "weight": "medium" }
      },
      "c2sub": {
        "type": "Caption",
        "props": { "text": "Support Agent" }
      },
      "c2badges": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c2score", "c2pass"]
      },
      "c2score": {
        "type": "Badge",
        "props": { "text": "74 / 100", "tone": "destructive" }
      },
      "c2pass": {
        "type": "Badge",
        "props": { "text": "Fail", "tone": "destructive" }
      },

      "c3": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["c3info", "c3badges"]
      },
      "c3info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c3name", "c3sub"]
      },
      "c3name": {
        "type": "Text",
        "props": { "text": "Alice M.", "size": "sm", "weight": "medium" }
      },
      "c3sub": {
        "type": "Caption",
        "props": { "text": "Support Agent" }
      },
      "c3badges": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c3score", "c3pass"]
      },
      "c3score": {
        "type": "Badge",
        "props": { "text": "88 / 100", "tone": "positive" }
      },
      "c3pass": {
        "type": "Badge",
        "props": { "text": "Pass", "tone": "positive" }
      },

      "c4": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["c4info", "c4badges"]
      },
      "c4info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c4name", "c4sub"]
      },
      "c4name": {
        "type": "Text",
        "props": { "text": "Carol T.", "size": "sm", "weight": "medium" }
      },
      "c4sub": {
        "type": "Caption",
        "props": { "text": "Support Agent" }
      },
      "c4badges": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c4score", "c4pass"]
      },
      "c4score": {
        "type": "Badge",
        "props": { "text": "95 / 100", "tone": "positive" }
      },
      "c4pass": {
        "type": "Badge",
        "props": { "text": "Pass", "tone": "positive" }
      },

      "c5": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["c5info", "c5badges"]
      },
      "c5info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c5name", "c5sub"]
      },
      "c5name": {
        "type": "Text",
        "props": { "text": "Bob K.", "size": "sm", "weight": "medium" }
      },
      "c5sub": {
        "type": "Caption",
        "props": { "text": "Support Agent" }
      },
      "c5badges": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["c5score", "c5pass"]
      },
      "c5score": {
        "type": "Badge",
        "props": { "text": "61 / 100", "tone": "destructive" }
      },
      "c5pass": {
        "type": "Badge",
        "props": { "text": "Fail", "tone": "destructive" }
      },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Talkdesk",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://my.talkdesk.com", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
