{
  "id": "cliniko-businesses",
  "title": "Cliniko — Businesses / locations",
  "description": "Business locations configured in the account.",
  "category": "health",
  "tags": [
    "cliniko",
    "practice",
    "locations",
    "businesses"
  ],
  "keywords": [
    "business",
    "location",
    "clinic",
    "site",
    "branch"
  ],
  "connectorsUsed": [
    "cliniko-practice"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "cliniko-practice",
    "tool": "list_businesses",
    "params": {
      "per_page": 50,
      "sort": "business_name:asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "table"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Businesses",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-practice/list_businesses/total_entries"
              }
            }
          }
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/cliniko-practice.list_businesses"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/cliniko-practice/list_businesses/businesses"
          },
          "columns": [
            {
              "id": "name",
              "header": "Business",
              "field": "business_name",
              "priority": 1,
              "width": 220
            },
            {
              "id": "city",
              "header": "City",
              "field": "city",
              "priority": 2,
              "width": 140
            },
            {
              "id": "country",
              "header": "Country",
              "field": "country",
              "priority": 3,
              "width": 120
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
