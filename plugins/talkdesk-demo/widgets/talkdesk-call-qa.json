{
  "id": "talkdesk-call-qa",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores from the mySMB scoring service.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 4 },
    "min":       { "colSpan": 4, "rowSpan": 3 },
    "max":       { "colSpan": 10, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "avg", "table"]
      },
      "header": {
        "type": "Header",
        "props": { "title": "Call QA Scorecard", "subtitle": "Recent scored calls" }
      },
      "avg": {
        "type": "Stat",
        "props": {
          "label": "Avg Score",
          "value": 82,
          "suffix": "/100"
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "rows": [
            { "agent": "Alice M.",  "overall_score": 92, "grade": "A", "summary": "92/100 — Excellent",         "scored_at": "2026-05-25T08:10:00Z" },
            { "agent": "Bob K.",    "overall_score": 74, "grade": "C", "summary": "74/100 — Needs Improvement", "scored_at": "2026-05-25T09:22:00Z" },
            { "agent": "Alice M.",  "overall_score": 88, "grade": "B", "summary": "88/100 — Good",              "scored_at": "2026-05-25T10:05:00Z" },
            { "agent": "Carol T.",  "overall_score": 95, "grade": "A", "summary": "95/100 — Excellent",         "scored_at": "2026-05-25T11:15:00Z" },
            { "agent": "Bob K.",    "overall_score": 61, "grade": "C", "summary": "61/100 — Needs Improvement", "scored_at": "2026-05-25T12:30:00Z" }
          ],
          "columns": [
            { "key": "agent",         "label": "Agent" },
            { "key": "overall_score", "label": "Score" },
            { "key": "grade",         "label": "Grade" },
            { "key": "summary",       "label": "Result" },
            { "key": "scored_at",     "label": "Time", "format": "datetime" }
          ]
        }
      }
    }
  }
}
