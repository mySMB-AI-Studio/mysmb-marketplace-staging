{
  "id": "m365-calendar-today",
  "title": "Today",
  "description": "Timeline of today's meetings with attendees, description, and one-tap RSVP.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "outlook",
    "meetings",
    "schedule"
  ],
  "keywords": [
    "today",
    "schedule",
    "calendar",
    "meetings",
    "events"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 92,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-calendar",
    "tool": "list_events",
    "params": {
      "startDateTime": "$today",
      "endDateTime": "$today_end",
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ],
        "watch": {
          "/m365-calendar/list_events": {
            "action": "setState",
            "params": {
              "statePath": "/ui/todayEvents",
              "value": {
                "$computed": "filter_date_range",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/list_events"
                  },
                  "field": "start.dateTime"
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarDays",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Today's Schedule",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Meetings",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/todayEvents"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-calendar.list_events"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No meetings — go do deep work."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-calendar.list_events",
              "not": true
            },
            {
              "$state": "/ui/todayEvents/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/ui/todayEvents",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-calendar.list_events",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "timePill",
          "labels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMode",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMessage",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-calendar.get_event",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "timePill": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{t}",
              "t": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  }
                }
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "subject",
          "scheduleRow",
          "subtitle"
        ]
      },
      "subject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "scheduleRow": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{start} – {end} · {dur}",
              "start": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  }
                }
              },
              "end": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "end/dateTime"
                  }
                }
              },
              "dur": {
                "$computed": "duration_between",
                "args": {
                  "start": {
                    "$item": "start/dateTime"
                  },
                  "end": {
                    "$item": "end/dateTime"
                  }
                }
              }
            }
          }
        }
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{loc} · {org}",
              "loc": {
                "$item": "location/displayName"
              },
              "org": {
                "$item": "organizer/emailAddress/name"
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "36rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEventId"
        },
        "on": {
          "backdropClick": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMode",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMessage",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": ""
              }
            }
          ]
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "children": [
          "detailTitle",
          "detailClose"
        ],
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        }
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-calendar/get_event/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMode",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMessage",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": ""
              }
            }
          ]
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading meeting…"
        },
        "visible": {
          "$state": "/m365-calendar/get_event/id",
          "neq": {
            "$state": "/ui/selectedEventId"
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "detailMeta",
          "attDivider",
          "attHeader",
          "attList",
          "descSection",
          "rsvpDivider",
          "rsvpBanner",
          "rsvpHeader",
          "rsvpRow",
          "declineBox",
          "linksRow"
        ],
        "visible": {
          "$state": "/m365-calendar/get_event/id",
          "eq": {
            "$state": "/ui/selectedEventId"
          }
        }
      },
      "detailMeta": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvWhen",
          "kvOrganizer",
          "kvLocation"
        ]
      },
      "kvWhen": {
        "type": "KeyValue",
        "props": {
          "label": "When",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{date} · {start} – {end}",
              "date": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/get_event/start/dateTime"
                  },
                  "format": "long"
                }
              },
              "start": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/get_event/start/dateTime"
                  }
                }
              },
              "end": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/get_event/end/dateTime"
                  }
                }
              }
            }
          }
        }
      },
      "kvOrganizer": {
        "type": "KeyValue",
        "props": {
          "label": "Organizer",
          "value": {
            "$state": "/m365-calendar/get_event/organizer/emailAddress/name"
          }
        }
      },
      "kvLocation": {
        "type": "KeyValue",
        "props": {
          "label": "Where",
          "value": {
            "$state": "/m365-calendar/get_event/location/displayName"
          }
        }
      },
      "attDivider": {
        "type": "Divider"
      },
      "attHeader": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Attendees",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/get_event/attendees"
                  }
                }
              }
            }
          }
        }
      },
      "attList": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "attRow"
        ],
        "repeat": {
          "statePath": "/m365-calendar/get_event/attendees",
          "key": "emailAddress/address"
        }
      },
      "attRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "attAvatar",
          "attName"
        ]
      },
      "attAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "attName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "emailAddress/name"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "descSection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "descHtml"
        ],
        "visible": {
          "$state": "/m365-calendar/get_event/body/content"
        }
      },
      "descHtml": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/m365-calendar/get_event/body/content"
          },
          "minHeight": 80,
          "maxHeight": 320
        }
      },
      "rsvpDivider": {
        "type": "Divider"
      },
      "rsvpBanner": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/rsvpResult"
          },
          "size": "sm",
          "weight": "medium",
          "tone": "accent"
        },
        "visible": {
          "$state": "/ui/rsvpResult"
        }
      },
      "rsvpHeader": {
        "type": "Eyebrow",
        "props": {
          "text": "Your response"
        },
        "visible": {
          "$state": "/ui/declineMode",
          "not": true
        }
      },
      "rsvpRow": {
        "type": "Row",
        "props": {
          "gap": "sm"
        },
        "children": [
          "acceptBtn",
          "tentativeBtn",
          "declineBtn"
        ],
        "visible": {
          "$state": "/ui/declineMode",
          "not": true
        }
      },
      "acceptBtn": {
        "type": "Button",
        "props": {
          "label": "Accept",
          "size": "sm",
          "leadingIcon": "Check",
          "variant": {
            "$cond": {
              "$state": "/m365-calendar/get_event/responseStatus/response",
              "eq": "accepted"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-calendar.respond_to_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                },
                "response": "accept"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": "You accepted this meeting."
              }
            },
            {
              "action": "m365-calendar.get_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                }
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 50
              }
            }
          ]
        }
      },
      "tentativeBtn": {
        "type": "Button",
        "props": {
          "label": "Tentative",
          "size": "sm",
          "leadingIcon": "CircleHelp",
          "variant": {
            "$cond": {
              "$state": "/m365-calendar/get_event/responseStatus/response",
              "eq": "tentativelyAccepted"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-calendar.respond_to_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                },
                "response": "tentative"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": "You marked this meeting tentative."
              }
            },
            {
              "action": "m365-calendar.get_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                }
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 50
              }
            }
          ]
        }
      },
      "declineBtn": {
        "type": "Button",
        "props": {
          "label": "Decline",
          "size": "sm",
          "leadingIcon": "X",
          "variant": {
            "$cond": {
              "$state": "/m365-calendar/get_event/responseStatus/response",
              "eq": "declined"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/declineMode",
              "value": "1"
            }
          }
        }
      },
      "declineBox": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "declineLabel",
          "declineInput",
          "declineActions"
        ],
        "visible": {
          "$state": "/ui/declineMode"
        }
      },
      "declineLabel": {
        "type": "Text",
        "props": {
          "text": "Add a message for the organizer (required to decline).",
          "size": "sm",
          "tone": "muted"
        }
      },
      "declineInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/declineMessage"
          },
          "placeholder": "Let them know why you can't make it…",
          "multiline": true,
          "rows": 3
        }
      },
      "declineActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "declineBackBtn",
          "declineSendBtn"
        ]
      },
      "declineBackBtn": {
        "type": "Button",
        "props": {
          "label": "Back",
          "variant": "ghost",
          "size": "sm"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/declineMode",
              "value": ""
            }
          }
        }
      },
      "declineSendBtn": {
        "type": "Button",
        "props": {
          "label": "Send decline",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send"
        },
        "visible": {
          "$state": "/ui/declineMessage"
        },
        "on": {
          "click": [
            {
              "action": "m365-calendar.respond_to_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                },
                "response": "decline",
                "comment": {
                  "$state": "/ui/declineMessage"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMode",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/declineMessage",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpResult",
                "value": ""
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 50
              }
            }
          ]
        }
      },
      "linksRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "joinBtn",
          "outlookBtn"
        ]
      },
      "joinBtn": {
        "type": "Button",
        "props": {
          "label": "Join meeting",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Video"
        },
        "visible": {
          "$state": "/m365-calendar/get_event/onlineMeeting/joinUrl"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/m365-calendar/get_event/onlineMeeting/joinUrl"
              }
            }
          }
        }
      },
      "outlookBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/m365-calendar/get_event/webLink"
              }
            }
          }
        }
      }
    }
  },
  "status": "published"
}
