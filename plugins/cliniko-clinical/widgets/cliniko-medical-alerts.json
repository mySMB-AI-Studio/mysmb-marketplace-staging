{
  "id": "cliniko-medical-alerts",
  "title": "Cliniko — Medical alerts",
  "description": "Active medical alerts across patients.",
  "category": "health",
  "tags": [
    "cliniko",
    "clinical",
    "safety",
    "alerts"
  ],
  "keywords": [
    "medical alert",
    "allergy",
    "warning",
    "safety"
  ],
  "connectorsUsed": [
    "cliniko-clinical"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "cliniko-clinical",
    "tool": "list_medical_alerts",
    "params": {
      "per_page": 50,
      "sort": "created_at:desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "table"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Medical alerts",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-clinical/list_medical_alerts/total_entries"
              }
            }
          }
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/cliniko-clinical.list_medical_alerts"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/cliniko-clinical/list_medical_alerts/medical_alerts"
          },
          "columns": [
            {
              "id": "name",
              "header": "Alert",
              "field": "name",
              "priority": 1,
              "width": 260
            },
            {
              "id": "created",
              "header": "Added",
              "field": "created_at",
              "priority": 2,
              "format": "relative",
              "width": 130
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
