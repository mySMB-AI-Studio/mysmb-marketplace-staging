{
  "id": "cliniko-appointment-types",
  "title": "Cliniko — Appointment types",
  "description": "Appointment types configured in the practice and their durations.",
  "category": "health",
  "tags": [
    "cliniko",
    "scheduling",
    "settings",
    "appointment types"
  ],
  "keywords": [
    "appointment type",
    "service",
    "duration",
    "offerings"
  ],
  "connectorsUsed": [
    "cliniko-scheduling"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "cliniko-scheduling",
    "tool": "list_appointment_types",
    "params": {
      "per_page": 50,
      "sort": "name:asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "table"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Appointment types",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-scheduling/list_appointment_types/total_entries"
              }
            }
          }
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/cliniko-scheduling.list_appointment_types"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/cliniko-scheduling/list_appointment_types/appointment_types"
          },
          "columns": [
            {
              "id": "name",
              "header": "Name",
              "field": "name",
              "priority": 1,
              "width": 220
            },
            {
              "id": "mins",
              "header": "Minutes",
              "field": "duration_in_minutes",
              "priority": 1,
              "width": 90,
              "align": "right"
            },
            {
              "id": "cat",
              "header": "Category",
              "field": "category",
              "priority": 3,
              "width": 140
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
