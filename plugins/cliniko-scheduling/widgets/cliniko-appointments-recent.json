{
  "id": "cliniko-appointments-recent",
  "title": "Cliniko — Recent appointments",
  "description": "Most recent individual appointments with start/end times and notes.",
  "category": "health",
  "tags": [
    "cliniko",
    "scheduling",
    "appointments",
    "calendar"
  ],
  "keywords": [
    "appointment",
    "appointments",
    "schedule",
    "booking",
    "calendar"
  ],
  "connectorsUsed": [
    "cliniko-scheduling"
  ],
  "popularity": 85,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "cliniko-scheduling",
    "tool": "list_individual_appointments",
    "params": {
      "per_page": 25,
      "sort": "starts_at:desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "table"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Appointments",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-scheduling/list_individual_appointments/total_entries"
              }
            }
          }
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/cliniko-scheduling.list_individual_appointments"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/cliniko-scheduling/list_individual_appointments/individual_appointments"
          },
          "columns": [
            {
              "id": "starts",
              "header": "Starts",
              "field": "starts_at",
              "priority": 1,
              "format": "relative",
              "width": 150
            },
            {
              "id": "ends",
              "header": "Ends",
              "field": "ends_at",
              "priority": 3,
              "format": "relative",
              "width": 150
            },
            {
              "id": "notes",
              "header": "Notes",
              "field": "notes",
              "priority": 2,
              "width": 240
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
